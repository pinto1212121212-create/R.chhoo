rules_version = '2';

// כל מסמך שייך למשתמש אחד, ורק הוא יכול לגשת אליו.
// התוכן מוצפן בצד הלקוח — Firestore רואה רק iv ו-ct, ולא יכול לקרוא אותם.
// הכללים כאן הם שכבת ההגנה השנייה: גם מי שישיג את קונפיגורציית הפרויקט
// (שאינה סוד) לא יוכל לקרוא את המסמכים של משתמש אחר.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // המפתח העטוף — נכתב פעם אחת בהקמה, ומוחלף רק בשינוי סיסמה
      match /keys/{doc} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if request.auth != null
                     && request.auth.uid == uid
                     && request.resource.data.keys().hasOnly(['salt','iv','wrapped','iterations','version','updatedAt'])
                     && request.resource.data.wrapped is string
                     && request.resource.data.wrapped.size() < 500;
      }

      // רשומות מוצפנות
      match /entries/{id} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if request.auth != null
                     && request.auth.uid == uid
                     && request.resource.data.keys().hasOnly(['iv','ct','updatedAt','deleted'])
                     && request.resource.data.ct is string
                     && request.resource.data.ct.size() < 100000
                     && request.resource.data.updatedAt is int;
      }

      // הגדרות וצ'קליסט, מוצפנים
      match /meta/{id} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if request.auth != null
                     && request.auth.uid == uid
                     && request.resource.data.keys().hasOnly(['iv','ct','updatedAt'])
                     && request.resource.data.ct.size() < 1000000;
      }

      // אינדקס הקבצים — הקובץ עצמו ב-Storage, כאן רק המטא-דאטה
      match /files/{id} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if request.auth != null
                     && request.auth.uid == uid
                     && request.resource.data.keys().hasOnly(['iv','ct','updatedAt','deleted','size']);
      }
    }

    // כל השאר חסום
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
